# Google Drive / Meet
GOOGLE_CREDENTIALS_FILE=credentials.json

# Zoho Meetings
ZOHO_CLIENT_ID=seu_client_id
ZOHO_CLIENT_SECRET=seu_client_secret
ZOHO_REFRESH_TOKEN=seu_refresh_token

# Whisper
# Opções: tiny, base, small, medium, large
WHISPER_MODEL=base

# Idioma da transcrição (pt para português, en para inglês, auto para detectar)
WHISPER_LANGUAGE=pt

# Pasta de saída dos TXTs
OUTPUT_DIR=transcricoes
